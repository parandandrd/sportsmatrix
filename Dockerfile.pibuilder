# Cross-build environment for the aarch64 release binary. Nothing else uses it:
# lint, test and the amd64 build all run directly on the runner now.
#
# The official debian image is multi-arch, so buildx picks the right variant per
# --platform. The old base, multiarch/debian-debootstrap, was last published in
# 2020 and sat on Debian releases that are now past end of life.
ARG BASE=debian:trixie-slim

FROM $BASE

ARG GOVERSION=1.25.3

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      g++ \
      gcc \
      make \
      pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      arm64) goimg="go${GOVERSION}.linux-arm64.tar.gz" ;; \
      amd64) goimg="go${GOVERSION}.linux-amd64.tar.gz" ;; \
      *) echo "unsupported architecture $(dpkg --print-architecture)"; exit 1 ;; \
    esac; \
    curl -fsSL "https://go.dev/dl/${goimg}" -o "/tmp/${goimg}"; \
    tar -C /usr/local -xzf "/tmp/${goimg}"; \
    rm -f "/tmp/${goimg}"; \
    /usr/local/go/bin/go version

ENV PATH="/usr/local/go/bin:${PATH}"

# Compiled here so the archive matches the toolchain that will link against it.
COPY ./internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix.BASE /sportsmatrix_lib/rpi-rgb-led-matrix
RUN make -C /sportsmatrix_lib/rpi-rgb-led-matrix
