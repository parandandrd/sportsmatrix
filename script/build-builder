#!/bin/bash
# Builds and publishes the cross-build image. CI does this automatically when
# Dockerfile.pibuilder changes; run it by hand only to seed or debug the image.
#
# Publishing needs write access to the repo's GitHub Packages:
#   echo "$GITHUB_TOKEN" | docker login ghcr.io -u <your-github-user> --password-stdin
#
# NOPUSH=1 builds locally without publishing.
set -euo pipefail

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"
cd "${ROOT}"
source "${ROOT}/script/common"

NOPUSH="${NOPUSH:-}"
IMG="$(latestpibuilder)"

if [ -n "${NOPUSH}" ]; then
  # --load cannot handle a multi-platform manifest, so one platform only
  PLATFORM="${PLATFORM:-$(dockerplatform "$(uname -m)")}"
  OUT="--load"
else
  PLATFORM="${PLATFORM:-linux/amd64,linux/arm64/v8}"
  OUT="--push"
fi

# Install the emulators needed to build a foreign-architecture image
docker run --privileged --rm tonistiigi/binfmt --install all

docker buildx inspect sportsmatrix >/dev/null 2>&1 || \
  docker buildx create --name=sportsmatrix --driver=docker-container

set -x
docker buildx build \
  --builder=sportsmatrix \
  --platform="${PLATFORM}" \
  -f Dockerfile.pibuilder \
  -t "${IMG}" \
  ${OUT} \
  .
