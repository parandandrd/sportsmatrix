#!/bin/bash
set -euo pipefail

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"
GO_VERSION="1.25.3"
# .golangci.yml is a v1 config; a v2 binary refuses it outright.
GOLANGCI_VERSION="1.64.6"

getsha() {
  if uname -s | grep -i darwin &> /dev/null; then
    shasum -a 256 "${1}" | awk '{print $1}'
  else
    sha256sum "${1}" | awk '{print $1}'
  fi
}

# One multi-arch image, tagged by the hash of the Dockerfile it was built from,
# in a registry this repo can actually publish to. Which architecture you get is
# chosen at run time with --platform, not by the tag.
BUILDER_REGISTRY="${SPORTSMATRIX_REGISTRY:-ghcr.io/parandandrd}"

latestpibuilder() {
  echo "${BUILDER_REGISTRY}/sportsmatrix-builder:$(getsha "${ROOT}/Dockerfile.pibuilder")"
}

dockerplatform() {
  case "$1" in
    aarch64|arm64)  echo "linux/arm64/v8" ;;
    amd64|x86_64)   echo "linux/amd64" ;;
    *)              echo "unsupported architecture for the builder image: $1" >&2; return 1 ;;
  esac
}

install_go() {
  if go version | grep "${GO_VERSION}"; then
    return
  fi

  if [ ! -d /usr/local/go ]; then
    mkdir -p /usr/local/go
  fi

  case "$(uname -m)" in
  aarch64)
    f="go${GO_VERSION}.linux-arm64.tar.gz"
    ;;
  armv7l|armv6l)
    f="go${GO_VERSION}.linux-armv6l.tar.gz"
    ;;
  esac

  echo "=> Installing Go from https://golang.org/dl/${f}"
  wget "https://golang.org/dl/${f}"
  sudo rm -rf /usr/local/go/*
  sudo tar -C /usr/local -xzf "${f}"
  rm -f "${f}"
}
