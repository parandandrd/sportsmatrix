#!/bin/bash
# Installs the golangci-lint release pinned in script/common into $1, or
# $(go env GOPATH)/bin, after checking it against the release's checksums.
#
# golangci-lint's own install.sh can't install v2.14.0: it finds the tarball's
# checksum with an unanchored grep, which also matches the release's
# ...tar.gz.sbom.json line, and fails "hash_sha256_verify ... did not verify".
set -euo pipefail

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"
source "${ROOT}/script/common"

DEST="${1:-$(go env GOPATH)/bin}"
V="${GOLANGCI_VERSION}"
NAME="golangci-lint-${V}-$(go env GOOS)-$(go env GOARCH)"
URL="https://github.com/golangci/golangci-lint/releases/download/v${V}"

TMP="$(mktemp -d)"
trap 'rm -rf "${TMP}"' EXIT
cd "${TMP}"

curl -sSfLO "${URL}/${NAME}.tar.gz"
curl -sSfLO "${URL}/golangci-lint-${V}-checksums.txt"
grep -E "^[0-9a-f]{64}  ${NAME}\.tar\.gz\$" "golangci-lint-${V}-checksums.txt" | sha256sum -c -

tar -xzf "${NAME}.tar.gz"
mkdir -p "${DEST}"
install -m 0755 "${NAME}/golangci-lint" "${DEST}/golangci-lint"
"${DEST}/golangci-lint" version
