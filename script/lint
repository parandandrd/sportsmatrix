#!/bin/bash
set -euo pipefail

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"
IN_DOCKER="${IN_DOCKER:-no}"
source "${ROOT}/script/common"
IMG=$(latestlinter)

if [ "${IN_DOCKER}" = "no" ]; then
  MOUNTOPTION=""
  if [ "$(uname -s)" = "Darwin" ]; then
    MOUNTOPTION=":delegated"
  fi

  set -x
  exec docker run -t --rm \
      -e IN_DOCKER=yes \
      -u $(id -u):$(id -g) \
      -v "${ROOT}":/src${MOUNTOPTION} \
      -w /src \
      -e GOCACHE="/src/.cache" \
      -e GOFLAGS="-buildvcs=false" \
      -e GOLANGCI_LINT_CACHE="/src/.cache" \
      -e GO111MODULE=on \
      -e CGO_ENABLED=1 \
      -e GITHUB_ACTIONS="${GITHUB_ACTIONS:-}" \
      "${IMG}" \
      /src/script/$(basename $0)
fi

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"

if [ ! -d ${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix ]; then
  # Dockerfile.pibuilder installs the built library to /sportsmatrix_lib, which
  # is where script/build takes it from. /sportslibs is an older location that
  # can still be present in a builder image, holding an archive built against a
  # different glibc -- linking that one fails with undefined references to
  # __isoc23_sscanf and friends. Prefer the current path, fall back to the old.
  for libdir in /sportsmatrix_lib/rpi-rgb-led-matrix /sportslibs/rpi-rgb-led-matrix; do
    if [ -d "${libdir}" ]; then
      cp -r "${libdir}" ${ROOT}/internal/rgbmatrix-rpi/lib/
      trap "rm -rf ${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix" EXIT
      break
    fi
  done
fi

fix=""

if [ ! -n "${GITHUB_ACTIONS}" ]; then
  fix="--fix"
fi

# Put some dummy assets here
trap "rm -rf ${ROOT}/internal/sportsmatrix/assets" EXIT
mkdir -p "${ROOT}/internal/sportsmatrix/assets/web"
touch "${ROOT}/internal/sportsmatrix/assets/web/foo"

set -x
golangci-lint run --verbose --timeout="5m" ${fix}
