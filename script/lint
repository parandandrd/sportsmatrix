#!/bin/bash
set -euo pipefail

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"
cd "${ROOT}"
source "${ROOT}/script/common"

# Was a Docker image from a registry this repo cannot publish to. The only
# thing it supplied that a plain checkout does not is golangci-lint itself and
# a C++ compiler for the cgo package's headers.

for cmd in go make g++; do
  command -v "${cmd}" >/dev/null || { echo "missing required command: ${cmd}" >&2; exit 1; }
done

if ! command -v golangci-lint >/dev/null; then
  cat >&2 <<MSG
golangci-lint not found. This repo's config is v1, so install ${GOLANGCI_VERSION}:

  curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh \\
    | sh -s -- -b "\$(go env GOPATH)/bin" v${GOLANGCI_VERSION}

A v2 golangci-lint will refuse .golangci.yml outright.
MSG
  exit 1
fi

export CGO_ENABLED=1

LIB="${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix"
ASSETS="${ROOT}/internal/sportsmatrix/assets"

# //go:embed assets needs something to embed. Only put a placeholder there,
# and only clear it afterwards, if there is not already a real web build.
MADE_ASSETS=no
[ -d "${ASSETS}/web" ] || MADE_ASSETS=yes

cleanup() {
  rm -rf "${LIB}"
  if [ "${MADE_ASSETS}" = "yes" ]; then
    rm -rf "${ASSETS}"
  fi
  return 0
}
trap cleanup EXIT

# golangci-lint cannot typecheck the cgo package without the C headers present.
rm -rf "${LIB}"
cp -r "${LIB}.BASE" "${LIB}"
make -C "${LIB}/lib"

if [ "${MADE_ASSETS}" = "yes" ]; then
  mkdir -p "${ASSETS}/web"
  touch "${ASSETS}/web/placeholder"
fi

fix=""
if [ -z "${GITHUB_ACTIONS:-}" ]; then
  fix="--fix"
fi

golangci-lint run --timeout=5m ${fix} "$@"
