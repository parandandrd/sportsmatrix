#!/bin/bash
set -euo pipefail

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"
IN_DOCKER="${IN_DOCKER:-no}"
source "${ROOT}/script/common"
IMG=$(latestlinter)

if [ "${IN_DOCKER}" = "no" ]; then
  MOUNTOPTION=""
  if [ "$(uname -s)" = "Darwin" ]; then
    MOUNTOPTION=":delegated"
  fi

  set -x
  exec docker run -t --rm \
      -e IN_DOCKER=yes \
      -u $(id -u):$(id -g) \
      -v "${ROOT}":/src${MOUNTOPTION} \
      -w /src \
      -e GOCACHE="/src/.cache" \
      -e GOFLAGS="-buildvcs=false" \
      -e GOLANGCI_LINT_CACHE="/src/.cache" \
      -e GO111MODULE=on \
      -e CGO_ENABLED=1 \
      -e GITHUB_ACTIONS="${GITHUB_ACTIONS:-}" \
      "${IMG}" \
      /src/script/$(basename $0)
fi

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"

# One trap, not two. bash replaces an EXIT trap when a second one is installed,
# so the earlier "clean up the matrix library" trap used to be silently
# discarded by the "clean up the dummy assets" trap below. That left the library
# sitting in the workspace, where the test step then picked it up instead of
# building its own.
cleanup() {
  rm -rf "${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix"
  rm -rf "${ROOT}/internal/sportsmatrix/assets"
}
trap cleanup EXIT

# Linting only needs the headers to typecheck the cgo package, so a prebuilt
# copy is fine here. Dockerfile.pibuilder installs it to /sportsmatrix_lib,
# which is where script/build takes it from; /sportslibs is an older location
# some builder images still carry. Fall back to the vendored source if neither
# is present.
if [ ! -d ${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix ]; then
  for libdir in \
    /sportsmatrix_lib/rpi-rgb-led-matrix \
    /sportslibs/rpi-rgb-led-matrix \
    "${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix.BASE"; do
    if [ -d "${libdir}" ]; then
      cp -r "${libdir}" "${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix"
      break
    fi
  done
fi

fix=""

if [ ! -n "${GITHUB_ACTIONS}" ]; then
  fix="--fix"
fi

# Put some dummy assets here
mkdir -p "${ROOT}/internal/sportsmatrix/assets/web"
touch "${ROOT}/internal/sportsmatrix/assets/web/foo"

set -x
golangci-lint run --verbose --timeout="5m" ${fix}
