#!/bin/bash
set -euo pipefail
set -x

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"
cd "${ROOT}"
IN_DOCKER="${IN_DOCKER:-no}"
SUFFIX="build"
BUILDARCH="${BUILDARCH:-$(uname -m)}"

if [ "${IN_DOCKER}" = "no" ]; then
  source "${ROOT}/script/common"
  pibuilder=$(latestpibuilder ${BUILDARCH})

  docker run -t --rm \
    -e IN_DOCKER=yes \
    -v "${ROOT}":/src \
    -w /src \
    ${pibuilder} \
    /src/script/$(basename $0)
  exit
fi

# Inside docker

export CGO_ENABLED=1
export GOCACHE=/src/.cache

set -x
ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"

# Build the matrix library from the vendored source rather than reusing a
# prebuilt archive from the builder image. The archives shipped in those images
# were compiled against a newer glibc and libstdc++ than the image itself links
# against, so linking the test binary fails on symbols like __isoc23_sscanf,
# __isoc23_strtol and std::__throw_bad_array_new_length. Compiling it here costs
# a couple of minutes and guarantees it matches the toolchain doing the link.
if [ ! -d ${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix ]; then
  cp -r "${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix.BASE" \
    "${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix"
  trap "rm -rf ${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix" EXIT
  make -C "${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix/lib"
fi

# Put some dummy assets here
trap "rm -rf ${ROOT}/internal/sportsmatrix/assets" EXIT
mkdir -p "${ROOT}/internal/sportsmatrix/assets/web"
touch "${ROOT}/internal/sportsmatrix/assets/web/foo"

cd /src
go test -v -mod=vendor ./...
