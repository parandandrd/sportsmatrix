#!/bin/bash
set -euo pipefail

ROOT="$(dirname $( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd ))"
cd "${ROOT}"

# This used to run inside a Docker image pulled from a registry this repo
# cannot publish to, so editing that Dockerfile broke it with no way to build a
# replacement. Everything the image actually supplied was a Go toolchain and a
# C++ compiler, so run the tests directly instead.

for cmd in go make g++; do
  command -v "${cmd}" >/dev/null || { echo "missing required command: ${cmd}" >&2; exit 1; }
done

export CGO_ENABLED=1

LIB="${ROOT}/internal/rgbmatrix-rpi/lib/rpi-rgb-led-matrix"
ASSETS="${ROOT}/internal/sportsmatrix/assets"

# Only clear the assets directory if this script is the thing that created it;
# a real web build may already be sitting there.
# //go:embed assets needs something to embed. Only put a placeholder there,
# and only clear it afterwards, if there is not already a real web build.
MADE_ASSETS=no
[ -d "${ASSETS}/web" ] || MADE_ASSETS=yes

cleanup() {
  rm -rf "${LIB}"
  if [ "${MADE_ASSETS}" = "yes" ]; then
    rm -rf "${ASSETS}"
  fi
  return 0
}
trap cleanup EXIT

# Build the matrix library from the vendored source rather than reusing a
# prebuilt archive. Archives compiled against a different glibc and libstdc++
# than the toolchain doing the link fail on symbols like __isoc23_sscanf.
rm -rf "${LIB}"
cp -r "${LIB}.BASE" "${LIB}"
make -C "${LIB}/lib"

if [ "${MADE_ASSETS}" = "yes" ]; then
  mkdir -p "${ASSETS}/web"
  touch "${ASSETS}/web/placeholder"
fi

go test -mod=vendor "$@" ./...
