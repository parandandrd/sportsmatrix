    "matrix.v1_BoardInfo": {
      "description": "Fields: name, enabled, in_between, rpc_path, section, in_config_file",
      "type": "object",
      "title": "BoardInfo describes one board this instance runs. Every board the binary can render is built, on defaults for any section the config file leaves out, so in_config_file is what says whether a board was actually configured.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "enabled is the board's current state, which the API can change at runtime"
        },
        "in_between": {
          "type": "boolean",
          "title": "in_between marks boards that render between the others rather than taking their own turn in the rotation"
        },
        "in_config_file": {
          "type": "boolean",
          "title": "in_config_file is false when section is missing from the config file and the board is running on defaults."
        },
        "name": {
          "type": "string",
          "title": "name as the board reports it, which is what Jump expects"
        },
        "rpc_path": {
          "type": "string",
          "title": "rpc_path is where this board mounts its own service, trailing slash included, e.g. \"/nhl/sport.v1.Sport/\". The service name in it says what kind of board this is, so a client can drive a board's own settings without a hardcoded table of leagues. Empty for a board with no service."
        },
        "section": {
          "type": "string",
          "title": "section is the top-level config file key this board is built from, e.g. \"nhlConfig\". A league's stats and headlines boards share its section."
        }
      }
    },
    "matrix.v1_BoardSettings": {
      "description": "Fields: name, has_board_delay, board_delay, min_board_delay, has_teams, watch_teams, favorite_teams, teams",
      "type": "object",
      "title": "BoardSettings are the settings of one board that can be changed while it runs. A board has only some of them, and the has_ fields say which. Setting them saves them to the config file.",
      "properties": {
        "board_delay": {
          "type": "string",
          "title": "how long the board shows for, as a duration such as \"15s\" or \"1m30s\". A sport board shows each game for this long. Left empty, it is unchanged."
        },
        "favorite_teams": {
          "type": "array",
