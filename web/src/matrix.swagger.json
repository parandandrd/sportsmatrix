    "matrix.v1_SetBoardEnabledReq": {
      "description": "Fields: name, enabled",
      "type": "object",
      "title": "SetBoardEnabledReq turns a single board on or off by name. SetAll is all or nothing, and every other way to toggle one board runs through that board's own service, which means knowing its kind and RPC path first.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "title": "name as ListBoards reports it. Matched case-insensitively, like Jump."
        }
      }
    },
